#!/bin/sh
# Starts the Lumora graphical installer (Calamares) from the live session.
if ! grep -qw 'boot=live' /proc/cmdline; then
  echo "Lumora is already installed on this computer."
  exit 0
fi
ENVV="DISPLAY=${DISPLAY:-:0} XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority} QT_QPA_PLATFORM=xcb"
if sudo -n true 2>/dev/null; then
  exec sudo -E env $ENVV calamares "$@"
else
  exec pkexec env $ENVV calamares "$@"
fi
